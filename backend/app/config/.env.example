AITEAM_ENV=local
ZW_AI_ENV=local

HOST=127.0.0.1
PORT=8788
FRONTEND_ORIGIN=http://127.0.0.1:5178
PUBLIC_BASE_URL=http://127.0.0.1:8788
AUTH_SECRET=replace-with-at-least-32-random-characters
MODEL_SECRET=replace-with-an-independent-32-character-key
CHANNEL_SECRET=replace-with-an-independent-32-character-key

DATABASE_NAME=aiteam_app
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

MODEL_CONFIG_PATH=config/model.yaml
MODEL_DEFAULT_ID=gpt-5.5
MODEL_MAX_TOKENS=8192
MODEL_REQUEST_TIMEOUT_MS=900000
AITEAM_MODEL_MODE=real
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_API_KEY_ENV=OPENAI_API_KEY
OPENAI_API_KEY=

EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-api/v1
EMBEDDING_API_KEY=
DASHSCOPE_API_BASE_URL=https://dashscope.aliyuncs.com/api/v1
DASHSCOPE_RERANK_BASE_URL=https://dashscope.aliyuncs.com/compatible-api/v1

GBRAIN_BASE_URL=http://127.0.0.1:3131
GBRAIN_MCP_URL=http://127.0.0.1:3131/mcp
GBRAIN_CLI=../gbrain/src/cli.ts

DOCUMENT_PROCESSOR_MODE=auto
EOPERA_BASE_URL=http://127.0.0.1:8000
EOPERA_PROCESS_OSS_PATH=/api/v1/integration/documents/process-oss
DOCUMENT_PROCESSOR_TIMEOUT_MS=200000
DOCUMENT_MEDIA_ANALYSIS_ENABLED=true
DOCUMENT_MEDIA_ANALYSIS_CONCURRENCY=2
DOCUMENT_SOURCE_URL_TTL_SECONDS=600

STORAGE_ROOT=../storage
STORAGE_DRIVER=local
OSS_ENDPOINT=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_PREFIX=aiteam
LOG_LEVEL=info
LOG_DIR=./logs

# Capacity and overload protection
DATABASE_POOL_MAX=12
QA_CONCURRENCY=12
QA_QUEUE_LIMIT=24
QA_REQUESTS_PER_MINUTE=30
PROVIDER_CONCURRENCY=8
PROVIDER_QUEUE_LIMIT=24
RETRIEVAL_MAX_WORKSPACES=8
ASSET_WORKER_CONCURRENCY=2
CHANNEL_PROCESSING_CONCURRENCY=4
CHANNEL_PROCESSING_QUEUE_LIMIT=20
CHANNEL_BINDING_LEASE_SECONDS=120
CHANNEL_PROCESSING_LEASE_SECONDS=180
CHANNEL_SYNC_INTERVAL_MS=15000
# Multimodal image/text retrieval (1024 dimensions)
MULTIMODAL_EMBEDDING_MODEL=multimodal-embedding-v1
MULTIMODAL_EMBEDDING_URL=https://dashscope.aliyuncs.com/api/v1/services/embeddings/multimodal-embedding/multimodal-embedding
