{
  "name": "@mem-kb/backend-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "start": "node dist/src/index.js",
    "start:worker": "node dist/src/worker.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "db:setup": "tsx src/db/setup.ts",
    "db:migrate": "tsx src/db/setup.ts --migrate-only",
    "db:create-admin": "tsx src/db/create-admin.ts",
    "data:backfill": "tsx src/db/backfill.ts",
    "analysis:backfill": "tsx src/db/backfill-analysis.ts",
    "embedding:backfill": "tsx src/db/backfill-embeddings.ts",
    "test": "npm run typecheck && npm run test:unit",
    "test:unit": "vitest run",
    "test:regression": "AITEAM_MODEL_MODE=mock ASSET_QUEUE_NAME=aiteam-asset-processing-regression tsx tests/regression.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.1.2",
    "@fastify/multipart": "^10.1.3",
    "@fastify/rate-limit": "^11.2.1",
    "ali-oss": "^6.23.0",
    "bullmq": "^6.3.12",
    "cheerio": "^1.2.0",
    "fastify": "^5.12.5",
    "ioredis": "^6.0.0",
    "jszip": "^3.10.2",
    "mammoth": "^1.13.0",
    "mime-types": "^3.0.1",
    "pdf-parse": "^2.4.5",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-roll": "^4.0.0",
    "prom-client": "^15.1.3",
    "read-excel-file": "^9.3.12",
    "sharp": "^0.35.5",
    "turndown": "^7.2.4",
    "yaml": "^2.9.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/ali-oss": "^6.23.3",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/turndown": "^5.0.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
