POSTGRES_PASSWORD=replace-with-a-long-database-password
AUTH_SECRET=replace-with-at-least-32-random-characters
MODEL_SECRET=replace-with-an-independent-32-character-key
CHANNEL_SECRET=replace-with-an-independent-32-character-key
GBRAIN_TOKEN=replace_with_at_least_32_random_characters
APP_ORIGIN=https://ai.example.com

# Model gateway
MODEL_BASE_URL=https://api.example.com/v1
MODEL_REQUEST_TIMEOUT_MS=900000
OPENAI_API_KEY=
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-api/v1
EMBEDDING_API_KEY=
DASHSCOPE_API_BASE_URL=https://dashscope.aliyuncs.com/api/v1
DASHSCOPE_RERANK_BASE_URL=https://dashscope.aliyuncs.com/compatible-api/v1

# Optional: use Aliyun OSS instead of the local Docker volume
STORAGE_DRIVER=local
OSS_ENDPOINT=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_PREFIX=aiteam

# Optional: personal WeChat iLink channel
WECHAT_ILINK_BASE_URL=https://ilinkai.weixin.qq.com
WECHAT_ILINK_POLL_TIMEOUT_MS=40000
WECHAT_ILINK_QR_TTL_SECONDS=120
CHANNEL_BINDING_LEASE_SECONDS=120
CHANNEL_PROCESSING_LEASE_SECONDS=180
CHANNEL_SYNC_INTERVAL_MS=15000
CHANNEL_PROCESSING_CONCURRENCY=4
CHANNEL_PROCESSING_QUEUE_LIMIT=20

# Capacity defaults: adjust only after observing production metrics
DATABASE_POOL_MAX=12
QA_CONCURRENCY=12
QA_QUEUE_LIMIT=24
QA_REQUESTS_PER_MINUTE=30
PROVIDER_CONCURRENCY=8
PROVIDER_QUEUE_LIMIT=24
RETRIEVAL_MAX_WORKSPACES=8
ASSET_WORKER_CONCURRENCY=2
